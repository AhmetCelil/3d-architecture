<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <!-- 1️⃣ USER SEQUENCE -->
    <changeSet id="20251012-01" author="ahmet.celil.yalman">
        <createSequence sequenceName="user_sequence" startValue="1" incrementBy="1"/>
    </changeSet>

    <!-- 2️⃣ USERS -->
    <changeSet id="20251012-02" author="ahmet.celil.yalman">
        <createTable tableName="users">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="email" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="password" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="role" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="enabled" type="BOOLEAN" defaultValueBoolean="true"/>
        </createTable>
    </changeSet>

    <!-- 3️⃣ USER_PROFILES -->
    <changeSet id="20251012-03" author="ahmet.celil.yalman">
        <createTable tableName="user_profiles">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="first_name" type="VARCHAR(255)"/>
            <column name="last_name" type="VARCHAR(255)"/>
            <column name="phone_number" type="VARCHAR(255)"/>
            <column name="address" type="VARCHAR(255)"/>
            <column name="profile_picture" type="VARCHAR(255)"/>
            <column name="description" type="TEXT"/>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false" unique="true"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="user_profiles"
                baseColumnNames="user_id"
                constraintName="fk_user_profiles_user"
                referencedTableName="users"
                referencedColumnNames="id"
                onDelete="CASCADE"/>
    </changeSet>

    <!-- 4️⃣ COMPANY_PROJECTS -->
    <changeSet id="20251012-04" author="ahmet.celil.yalman">
        <createTable tableName="company_projects">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="project_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="category" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="location" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="total_area" type="DOUBLE PRECISION"/>
            <column name="start_date" type="DATE"/>
            <column name="end_date" type="DATE"/>
            <column name="status" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="duration_months" type="INTEGER"/>
            <column name="description" type="TEXT"/>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="company_projects"
                baseColumnNames="user_id"
                constraintName="fk_company_projects_user"
                referencedTableName="users"
                referencedColumnNames="id"
                onDelete="CASCADE"/>
    </changeSet>

    <!-- 5️⃣ PROJECT_TECHNICAL_SPECS (ElementCollection) -->
    <changeSet id="20251012-05" author="ahmet.celil.yalman">
        <createTable tableName="project_technical_specs">
            <column name="project_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="specification" type="VARCHAR(500)"/>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="project_technical_specs"
                baseColumnNames="project_id"
                constraintName="fk_project_technical_specs_project"
                referencedTableName="company_projects"
                referencedColumnNames="id"
                onDelete="CASCADE"/>
    </changeSet>

    <!-- 6️⃣ PROJECT_FEATURES (ElementCollection) -->
    <changeSet id="20251012-06" author="ahmet.celil.yalman">
        <createTable tableName="project_features">
            <column name="project_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="feature" type="VARCHAR(255)"/>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="project_features"
                baseColumnNames="project_id"
                constraintName="fk_project_features_project"
                referencedTableName="company_projects"
                referencedColumnNames="id"
                onDelete="CASCADE"/>
    </changeSet>

    <!-- 7️⃣ PROJECT_IMAGES (BYTEA - Görseller) -->
    <changeSet id="20251012-07" author="ahmet.celil.yalman">
        <createTable tableName="project_images">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="file_name" type="VARCHAR(255)"/>
            <column name="file_type" type="VARCHAR(100)"/>
            <column name="image_data" type="BYTEA"/>
            <column name="project_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="project_images"
                baseColumnNames="project_id"
                constraintName="fk_project_images_project"
                referencedTableName="company_projects"
                referencedColumnNames="id"
                onDelete="CASCADE"/>
    </changeSet>

    <!-- 8️⃣ PROJECT_FILES (BYTEA - Kat planları veya PDF) -->
    <changeSet id="20251013-08" author="ahmet.celil.yalman">
        <createTable tableName="project_files">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="file_name" type="VARCHAR(255)"/>
            <column name="file_type" type="VARCHAR(100)"/>
            <column name="file_data" type="BYTEA"/>
            <column name="project_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="project_files"
                baseColumnNames="project_id"
                constraintName="fk_project_files_project"
                referencedTableName="company_projects"
                referencedColumnNames="id"
                onDelete="CASCADE"/>
    </changeSet>

</databaseChangeLog>